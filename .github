name: build-apk

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: android-actions/setup-android@v3

      - name: Compilar APK
        run: |
          sdkmanager "platforms;android-34" "build-tools;34.0.0"
          BT="$ANDROID_HOME/build-tools/34.0.0"
          AJAR="$ANDROID_HOME/platforms/android-34/android.jar"
          mkdir -p out build
          javac -source 8 -target 8 -Xlint:-options -cp "$AJAR" -d out $(find src -name '*.java')
          "$BT/d8" --release --min-api 16 --lib "$AJAR" --output build $(find out -name '*.class')
          "$BT/aapt" package -f -M AndroidManifest.xml -I "$AJAR" -F build/base.apk
          (cd build && zip -j base.apk classes.dex)
          keytool -genkeypair -keystore debug.keystore -storepass android -keypass android \
            -alias debug -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=Android Debug,O=Android,C=US"
          "$BT/zipalign" -f 4 build/base.apk build/aligned.apk
          "$BT/apksigner" sign --ks debug.keystore --ks-pass pass:android \
            --ks-key-alias debug --key-pass pass:android --out build/prisma3d.apk build/aligned.apk

      - uses: actions/upload-artifact@v4
        with:
          name: prisma3d-apk
          path: build/prisma3d.apk
